# Dependencies
node_modules/
.pnpm-store/

# Vite build output
dist/
dev-dist/

# Engines fetched at build time from each engine's GitHub Release (scripts/fetch-engines.mjs)
public/engines/

# Local build/cache artifacts
.cache/
/.tmp

# Engine subprojects are independent, individually git-init'd repos
# (github.com/wasm-gaming/<engine>). Cloned here for local dev; never committed
# to this repo. The app consumes their CI-built WASM via GitHub Releases.
engines/
public/game/celeste/*
public/game/sonic-1/*
public/game/sonic-2/*
public/game/sonic-3/*
public/game/sonic-mania/*
public/game/sonic-cd/*
public/game/smario-world/*
public/assets/celeste/celeste-assets.*
game-assets/*

# jgenesis build output (WASM + JS glue, generated by build script)
legacy/public/console/megadrive/*
legacy/public/console/snes/*
legacy/public/console/shared/*

# ROMs are user-provided, not committed (per-console subdirectories).
# Ignore everything under legacy/public/roms/ except .gitkeep files (root and
# per-console) and the per-console directories themselves.
legacy/public/roms/*
!legacy/public/roms/.gitkeep
!legacy/public/roms/*/
!legacy/public/roms/*/.gitkeep
legacy/public/roms/*/*
!legacy/public/roms/*/.gitkeep
# Generated per-console manifests are not committed
legacy/public/roms/roms.*.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor
.DS_Store
.vscode/
