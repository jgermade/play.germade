# Dependencies
node_modules/
.pnpm-store/

# Astro build output
.astro/
dist/

# Local build/cache artifacts
.cache/
/.tmp
public/game/celeste/*
public/game/sonic-1/*
public/game/sonic-2/*
public/game/sonic-3/*
public/game/sonic-mania/*
public/game/sonic-cd/*
public/game/smario-world/*
public/assets/celeste/celeste-assets.*
game-assets/*

# jgenesis build output (WASM + JS glue, generated by build script)
public/console/megadrive/*
public/console/snes/*
public/console/shared/*

# ROMs are user-provided, not committed (per-console subdirectories).
# Ignore everything under public/roms/ except .gitkeep files (root and
# per-console) and the per-console directories themselves.
public/roms/*
!public/roms/.gitkeep
!public/roms/*/
!public/roms/*/.gitkeep
public/roms/*/*
!public/roms/*/.gitkeep
# Generated per-console manifests are not committed
public/roms/roms.*.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor
.DS_Store
.vscode/
