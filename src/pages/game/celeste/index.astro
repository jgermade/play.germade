---

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Celeste/Everest - play.germade.dev</title>
    <style>
      :root {
        --bg: #0d1a26;
        --panel: #12283a;
        --panel-2: #163650;
        --text: #e8f0f7;
        --muted: #9db3c7;
        --accent: #53d3ff;
        --accent-2: #7ce8ff;
        --ok: #87e8b0;
        --danger: #ff9292;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Segoe UI", Tahoma, sans-serif;
        color: var(--text);
        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(124, 232, 255, 0.12),
            transparent 28%
          ),
          radial-gradient(
            circle at 90% 10%,
            rgba(83, 211, 255, 0.1),
            transparent 25%
          ),
          var(--bg);
        min-height: 100vh;
        padding: 24px;
      }

      .layout {
        width: min(1100px, 100%);
        margin: 0 auto;
        display: grid;
        gap: 16px;
      }

      .panel {
        background: linear-gradient(180deg, var(--panel), var(--panel-2));
        border: 1px solid rgba(124, 232, 255, 0.2);
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
      }

      h1 {
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        margin-bottom: 6px;
        color: var(--accent-2);
      }

      p {
        color: var(--muted);
        line-height: 1.5;
      }

      .status {
        margin-top: 10px;
        font-size: 0.95rem;
      }

      .status.ok {
        color: var(--ok);
      }

      .status.err {
        color: var(--danger);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
      }

      .btn {
        border: 1px solid rgba(124, 232, 255, 0.3);
        color: var(--text);
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 8px;
        background: rgba(83, 211, 255, 0.12);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .btn:hover {
        border-color: var(--accent-2);
        background: rgba(83, 211, 255, 0.2);
      }

      iframe {
        width: 100%;
        height: min(72vh, 780px);
        border: 0;
        border-radius: 12px;
        background: #000;
        display: none;
      }

      .setup {
        margin-top: 10px;
        padding: 14px;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(124, 232, 255, 0.18);
      }

      code {
        color: var(--accent-2);
      }
    </style>
  </head>
  <body>
    <main class="layout">
      <section class="panel">
        <h1>Celeste/Everest</h1>
        <p id="runtime-status" class="status">Checking local build...</p>
        <div class="actions">
          <a class="btn" href="/">Back to launcher</a>
        </div>
      </section>

      <iframe id="celeste-frame" title="Celeste/Everest"></iframe>
    </main>

    <script>
      import { Unzip, UnzipInflate, UnzipPassThrough } from "fflate";

      const buildEntry = "/game/celeste/build/index.html";
      const statusEl = document.getElementById("runtime-status");
      const frame = document.getElementById("celeste-frame");

      if (
        !(statusEl instanceof HTMLElement) ||
        !(frame instanceof HTMLIFrameElement)
      ) {
        throw new Error("Runtime UI elements were not found in the page.");
      }

      async function checkOpfsPopulated() {
        try {
          const root = await navigator.storage.getDirectory();
          await root.getFileHandle(".ContentExists", { create: false });
          return true;
        } catch {
          return false;
        }
      }

      async function extractAssetsStreaming() {
        const res = await fetch("/game/celeste/assets.zip");
        if (!res.ok)
          throw new Error(
            "assets.zip not found on the server. Please run the packaging script first.",
          );

        const contentLength = res.headers.get("content-length");
        const total = contentLength ? parseInt(contentLength, 10) : 0;
        let loaded = 0;

        const reader = res.body!.getReader();
        const root = await navigator.storage.getDirectory();

        return new Promise<void>((resolve, reject) => {
          const unzipper = new Unzip();
          unzipper.register(UnzipInflate);
          unzipper.register(UnzipPassThrough);

          let activeWrites = 0;
          let ended = false;

          const checkDone = async () => {
            if (ended && activeWrites === 0) {
              try {
                await root.getFileHandle(".ContentExists", { create: true });
                resolve();
              } catch (e) {
                reject(e);
              }
            }
          };

          unzipper.onEnd = () => {
            console.log("fflate onEnd called!");
            ended = true;
            checkDone();
          };

          const writeQueue: (() => Promise<void>)[] = [];
          let isWriting = false;

          async function processWriteQueue() {
            if (isWriting) return;
            isWriting = true;
            while (writeQueue.length > 0) {
              const task = writeQueue.shift();
              if (task) {
                try {
                  await task();
                } catch (e) {
                  console.error("Queue task error:", e);
                }
              }
              // Update UI with queue status
              if (ended) {
                statusEl.textContent = `Writing to disk... (${activeWrites} files remaining)`;
              }
            }
            isWriting = false;
          }

          const dirCache: Record<string, FileSystemDirectoryHandle> = {
            "": root,
          };
          async function getCachedDir(pathParts: string[]) {
            let current = root;
            let currentPath = "";
            for (const part of pathParts) {
              if (!part) continue;
              currentPath += (currentPath ? "/" : "") + part;
              if (!dirCache[currentPath]) {
                dirCache[currentPath] = await current.getDirectoryHandle(part, {
                  create: true,
                });
              }
              current = dirCache[currentPath];
            }
            return current;
          }

          unzipper.onfile = (file) => {
            if (file.name.endsWith("/")) {
              file.ondata = () => {};
              file.start();
              return;
            }

            let fileData: Uint8Array[] = [];
            file.ondata = (err, data, final) => {
              if (err) return reject(err);
              if (data) fileData.push(new Uint8Array(data));

              if (final) {
                activeWrites++;
                writeQueue.push(async () => {
                  try {
                    const pathParts = file.name.split("/");
                    const name = pathParts.pop();
                    if (name) {
                      // Update UI to show the current file (this will help debug if it hangs)
                      if (ended || activeWrites < 10) {
                        statusEl.textContent = `Writing (${activeWrites} left): ${name}`;
                      }
                      console.log("START WRITE:", name);
                      const dirHandle = await getCachedDir(pathParts);
                      const fileHandle = await dirHandle.getFileHandle(name, {
                        create: true,
                      });
                      const writable = await fileHandle.createWritable();
                      // Safari OPFS can deadlock if you write multiple small chunks or call write() in a loop.
                      // Since we have all chunks in memory, writing it as a single Blob is 100% reliable and faster.
                      await writable.write(new Blob(fileData));
                      await writable.close();
                      console.log("END WRITE:", name);
                    }
                  } catch (e) {
                    console.error("Error writing file", file.name, e);
                  } finally {
                    activeWrites--;
                    checkDone();
                  }
                });
                processWriteQueue();
              }
            };
            file.start();
          };

          (async () => {
            try {
              while (true) {
                // Backpressure: wait if there are too many pending file writes
                while (writeQueue.length > 10) {
                  await new Promise((resolve) => setTimeout(resolve, 10));
                }

                const { done, value } = await reader.read();
                if (done) {
                  console.log("reader returned done=true!");
                  unzipper.push(new Uint8Array(0), true);
                  ended = true;
                  checkDone();
                  break;
                }
                loaded += value.byteLength;
                if (total > 0) {
                  statusEl.textContent = `Downloading & Extracting assets... ${Math.round((loaded / total) * 100)}%`;
                }
                unzipper.push(value);
              }
            } catch (e) {
              console.error("Stream reader error:", e);
              reject(e);
            }
          })();
        });
      }

      async function boot() {
        try {
          const res = await fetch(buildEntry, { method: "HEAD" });
          if (!res.ok) throw new Error("Build not found");

          statusEl.textContent = "Checking local game assets...";
          const populated = await checkOpfsPopulated();

          if (!populated) {
            statusEl.textContent = "Downloading assets... 0%";
            statusEl.classList.remove("err");
            await extractAssetsStreaming();
          }

          frame.src = buildEntry;
          frame.style.display = "block";
          statusEl.textContent =
            "Game assets loaded. Launching Celeste/Everest...";
          statusEl.classList.add("ok");
        } catch (e: any) {
          statusEl.textContent =
            e.message ||
            "No build detected yet. Add files to public/game/celeste/build to run.";
          statusEl.classList.add("err");
        }
      }

      boot();
    </script>
  </body>
</html>
