{
  "name": "play-germade",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Netflix-style launcher for the wasm-gaming engines: a PWA built with jq79 and Vite that drives every engine through @wasm-gaming/engine-specs.",
  "scripts": {
    "engines": "node scripts/fetch-engines.mjs",
    "dev": "node scripts/fetch-engines.mjs && vite",
    "build": "node scripts/fetch-engines.mjs && node scripts/fetch-datasets.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "datasets": "node scripts/fetch-datasets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@wasm-gaming/engine-specs": "^0.4.1",
    "jq79": "0.7.12"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "playwright": "^1.61.1",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "2.0.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
